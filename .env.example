# Gemini API Key
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# 11Labs API Key (optional - for voice synthesis)
NEXT_PUBLIC_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Retell API Key (optional - alternative voice provider)
NEXT_PUBLIC_RETELL_API_KEY=your_retell_api_key_here

# Vapi Configuration (for AI Homebase voice agent)
# Get your public key from https://vapi.ai
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your_vapi_public_key_here

# Your Vapi Assistant ID
# Create an assistant at https://vapi.ai and copy its ID
NEXT_PUBLIC_VAPI_ASSISTANT_ID=your_assistant_id_here

# N8N Webhook URL (for goals tracking)
# Create a webhook workflow in N8N and paste the URL here
NEXT_PUBLIC_N8N_WEBHOOK_URL=your_n8n_webhook_url_here
